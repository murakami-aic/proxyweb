{
	// Configuración del Worker del foro (plan gratuito de Cloudflare)
	"name": "foro-luces",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	// Base de datos D1: crear con
	//   npx wrangler d1 create foro-luces
	// y copiar el database_id aquí
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "foro-luces",
			"database_id": "337b625e-25af-4b16-a361-4e51c84a1a46"
		}
	],
	// Bucket R2 para imágenes y audio: crear con
	//   npx wrangler r2 bucket create foro-luces
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "foro-luces"
		}
	],
	// El token de administrador se define como secreto:
	//   npx wrangler secret put ADMIN_TOKEN
	"vars": {
		// Orígenes permitidos (CORS). En producción pon tu dominio, ej: "https://tudominio.com"
		"ALLOWED_ORIGIN": "*",
		// Tamaños máximos en bytes (5 MB imagen, 20 MB audio)
		"MAX_IMAGE_SIZE": "5242880",
		"MAX_AUDIO_SIZE": "20971520"
	}
}